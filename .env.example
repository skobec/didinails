# Скопируй в .env.local и поправь под себя. Секреты не коммитить.
# Сейчас бэкенда нет — фронтенд работает на localStorage,
# поэтому все VITE_* ниже необязательны и имеют дефолты в src/config/business.ts.

# Название студии (используется в <title> и шапке)
VITE_APP_NAME=DiDiNails

# Slug бизнеса — задел под будущие публичные страницы вида /[slug].
# Сейчас один tenant, значение используется как префикс ключей localStorage.
VITE_BUSINESS_SLUG=didinails

# Флагманская студия для `/` (твой салон). После онбординга поставь сюда
# свой slug — главная станет твоей страницей, остальные мастера живут на /[slug].
# VITE_FEATURED_SLUG=didinails

# Таймзона мастера (IANA). Все слоты и записи интерпретируются в ней.
VITE_BUSINESS_TIMEZONE=Europe/Moscow

# --- Supabase (бесплатный бэкенд, см. docs/supabase-setup.md) ---
# Пока VITE_USE_SUPABASE !== 'true' приложение работает на localStorage.
# Флаг существует, чтобы случайно не упереться в ненастроенный бэкенд.
# Ключ — PUBLISHABLE (sb_publishable_*, публичный, для фронтенда).
# SECRET-ключи (sb_secret_*) сюда и в репозиторий — НИКОГДА.
# VITE_USE_SUPABASE=false
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Капча Cloudflare Turnstile (см. docs/captcha.md). Без ключа виджет
# не показывается, серверная проверка пропускается (dev-режим).
# VITE_TURNSTILE_SITE_KEY=
